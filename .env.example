# Report data source. Production requires an explicit value.
REPORT_DATA_MODE=mock

# Salesforce OAuth 2.0 client-credentials connected app (required in salesforce mode).
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=
SALESFORCE_API_VERSION=65.0

# Reserved for a future JWT bearer flow; not consumed by client-credentials mode.
SALESFORCE_USERNAME=
SALESFORCE_PRIVATE_KEY=

# Override unverified Ascendix API names after confirming them in the target org.
# SF_OBJECT_MARKET_DATA=Market_Data__c
# SF_FIELD_MARKET=Market__c
# SF_FIELD_PERIOD=Period__c

# Required for the MCP endpoint in production. Do not reuse Salesforce credentials.
MCP_API_KEY=

PORT=8787
LEE_DATA_DIR=server/data
LEE_RENDER_APP_URL=http://127.0.0.1:3000
