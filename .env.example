# Report source. Production requires an explicit value.
REPORT_DATA_MODE=mock

# Salesforce auth. Select exactly one mode and configure only its credential group.
SALESFORCE_AUTH_MODE=client-credentials
SALESFORCE_API_VERSION=65.0

# Production-preferred OAuth client credentials (client-credentials mode).
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=

# Local compatibility credentials (soap-login mode). SF_DOMAIN: login or test.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login

# MCP. Never reuse Salesforce credentials.
MCP_API_KEY=

PORT=8787
LEE_DATA_DIR=server/data
LEE_RENDER_APP_URL=http://127.0.0.1:3000

# Narrative generation. One workflow, selected by internal mode; there is no
# user-facing provider picker.
#   chatgpt_mcp  ChatGPT writes narratives through the remote LEE Intelligence
#                MCP. No OPENAI_API_KEY is required.
#   direct_model In-process model client. Retained for CI and future use.
NARRATIVE_GENERATION_MODE=chatgpt_mcp
NARRATIVE_MCP_URL=https://api.ascendixmcp.com/mcp
# ChatGPT custom-app URL opened on the Generate click. Configuration-driven:
# leave blank and Report Studio shows the handoff prompt instead.
NARRATIVE_MCP_CHATGPT_APP_URL=
NARRATIVE_MCP_POLL_MS=1500

# Direct-model path only. Not required when NARRATIVE_GENERATION_MODE is
# chatgpt_mcp; manual narrative editing is always available.
OPENAI_API_KEY=
OPENAI_NARRATIVE_MODEL=gpt-5.6-terra
NARRATIVE_GENERATION_CONCURRENCY=3
# Deterministic local/CI acceptance only. Production default is openai.
NARRATIVE_MODEL_PROVIDER=openai
